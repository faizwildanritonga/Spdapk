<?xml version="1.0" encoding="utf-8"?>
<!--
  vendor-id 6018 = 0x1782 (Spreadtrum/Unisoc), decimal karena atribut XML ini
  cuma terima decimal. Sengaja TIDAK filter product-id supaya semua PID
  (BROM/FDL1/FDL2/recovery, dsb) tetap ketangkep -- validasi PID dilakukan
  di kode (UsbWatchService), bukan di sini. Kalau ketemu device SPD dengan
  VID beda, tambahkan <usb-device> baru di bawah.
-->
<resources>
    <usb-device vendor-id="6018" />
</resources>
